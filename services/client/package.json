{
  "name": "ucd-lib-client",
  "version": "2.0.0",
  "description": "UC Davis Library Digital Collections client - independent standup, no longer built on fin/fcrepo (see docs/PORT-PLAN.md)",
  "main": "index.js",
  "scripts": {
    "test": "mocha",
    "dist": "cd client && ./dist.sh",
    "watch-admin-ext": "cd client/admin-ui-ext && webpack --watch --config ./webpack.config.js",
    "dist-admin-ext": "cd client/admin-ui-ext && webpack  --config ./webpack-dist.config.js",
    "build": "cd client && ./build.sh",
    "watch": "cd client && ./watch.sh",
    "analyze-bundle": "cd client && webpack --profile --json webpack-dist.config.js > stats.json && webpack-bundle-analyzer -m server stats.json",
    "start": "node index.js"
  },
  "author": "jrmerz@ucdavis.edu",
  "license": "MIT",
  "dependencies": {
    "@elastic/elasticsearch": "^8.13.1",
    "@ucd-lib/logger": "^0.0.7",
    "@ucd-lib/spa-router-middleware": "^0.2.1",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.1",
    "fs-extra": "^10.1.0",
    "http-proxy": "^1.18.1",
    "pg": "^8.11.3",
    "swagger-jsdoc": "^6.2.8",
    "xml2js": "^0.5.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.21.0",
    "@ucd-lib/cork-app-build": "^0.4.2",
    "mocha": "^10.4.0",
    "raw-loader": "^4.0.2",
    "supertest": "^7.0.0",
    "webpack": "^5.76.1",
    "webpack-cli": "^5.0.1"
  }
}
